{
  "name": "@crawlora-org/speedrun",
  "version": "0.1.0",
  "description": "Crawlora Speedrun.com API client with 20 endpoints for game and category discovery, leaderboards, records, variables, and run metadata",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=speedrun-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-speedrun/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "speedrun", "speedrun-com", "speedrun-api", "speedrun-com-api", "speedrun-scraper", "speedrun-com-scraper", "speedrun-data", "speedrun-com-data", "speedrun-game-category-discovery", "speedrun-leaderboards", "speedrun-records", "speedrun-variables", "speedrun-run-metadata"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
